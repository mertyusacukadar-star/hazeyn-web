    },
    {
      "source": "/ramazan-medine-40-vakit-programi/",
      "destination": "/programlar/ramazan-medine-40-vakit-programi.html"
    },
    {
      "source": "/tam-ramazan-umresi-37-gun",
      "destination": "/programlar/tam-ramazan-umresi-37-gun.html"
    },
    {
      "source": "/tam-ramazan-umresi-37-gun/",
      "destination": "/programlar/tam-ramazan-umresi-37-gun.html"
    },
    {
      "source": "/21-ocak-2027-umresi",
